[Unit]
Description=Pop-Up API
After=network.target postgresql.service

[Service]
Type=simple
# User/path as deployed on the corporate VM. Adjust if you clone elsewhere.
User=admintg
WorkingDirectory=/opt/pop-up-assistant/server
EnvironmentFile=/opt/pop-up-assistant/server/.env
ExecStart=/usr/bin/node src/index.js
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
