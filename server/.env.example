# ── Server ─────────────────────────────────────────────────────────
PORT=8090
# Bind to loopback only; a reverse proxy / Tailscale Funnel fronts it with TLS.
# Set HOST=0.0.0.0 only if running without any proxy.
HOST=127.0.0.1
# Comma-separated list of allowed frontend origins (GitHub Pages URL, custom domain).
# Example: https://<user>.github.io
CORS_ORIGINS=http://localhost:8000

# ── PostgreSQL ─────────────────────────────────────────────────────
DATABASE_URL=postgres://popup:popuppassword@localhost:5432/popup

# ── Cloudflare R2 (S3-compatible object storage) ───────────────────
# From the R2 dashboard: account id, an API token (access key/secret), bucket name.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=popup-documents
# Endpoint is https://<account_id>.r2.cloudflarestorage.com
R2_ENDPOINT=
# Optional public base URL if the bucket is served via a public domain;
# leave empty to use short-lived presigned download URLs.
R2_PUBLIC_BASE_URL=

# ── NOTE ───────────────────────────────────────────────────────────
# This deployment has NO authentication: anyone who can reach the API can read
# AND write the shared dataset. Keep the API URL private and rely on R2/CORS.
